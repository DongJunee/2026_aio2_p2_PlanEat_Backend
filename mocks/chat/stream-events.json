{
  "request_headers": {
    "Accept": "text/event-stream"
  },
  "events": [
    {
      "event": "start",
      "data": {
        "phase": "accepted"
      }
    },
    {
      "event": "progress",
      "data": {
        "phase": "processing"
      }
    },
    {
      "event": "delta",
      "data": {
        "index": 0,
        "text": "추천을 준비하고 있어요."
      }
    },
    {
      "event": "complete",
      "data": {
        "http_status": 200,
        "payload": {
          "$ref": "response-success.json"
        }
      }
    },
    {
      "event": "done",
      "data": {
        "reason": "complete"
      }
    }
  ]
}
