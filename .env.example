# =============================================================================
# PlanEat Backend 환경 변수 설정
# 로컬 개발 시 이 파일을 `.env`로 복사합니다. `.env`는 절대 커밋하지 않습니다.
# `<...>` 값은 관련 연동을 실행하기 전에 실제 값으로 교체합니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 애플리케이션
# -----------------------------------------------------------------------------
# 실행 환경 식별자입니다. 예: local, development, production
APP_ENV=local
# 서비스 메타데이터에 사용할 애플리케이션 이름입니다.
APP_NAME=PlanEat API

# -----------------------------------------------------------------------------
# 2. 저장소
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 3. Chat 및 LLM
# -----------------------------------------------------------------------------
# Chat 요청 한 건에서 허용하는 최대 첨부 파일 수입니다.
MAX_ATTACHMENTS=5

# API 완료 단계의 임시 추천 데이터와 안내 문구를 생성하는 OpenAI 설정입니다.
# 키는 https://platform.openai.com/api-keys 에서 만들고 외부에 공유하지 않습니다.
OPENAI_API_KEY=<your-openai-api-key>
# Chat API 완료 단계에서 기본으로 사용할 모델입니다.
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 4. LangSmith 관측성 (선택 사항)
# -----------------------------------------------------------------------------
# true이고 API 키가 있으면 ChatService의 LangGraph 실행을 LangSmith에 기록합니다.
LANGSMITH_TRACING=false
# https://smith.langchain.com 에서 발급합니다. 실제 키는 커밋하지 마세요.
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=planeat-backend
# LangSmith self-hosted를 사용할 때만 지정합니다.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 개인정보 보호를 위해 사용자 메시지·이미지 원문은 trace payload에 기록하지 않습니다.

# ----------------------------------------------------------------------------
# 5. TypeSafe Jev 결정 모델 (선택 사항)
# ----------------------------------------------------------------------------
# true일 때 CONDITION_INPUT의 식단 목적과 완료 후 피드백 계획을 TypeSafe API로 전송해
# 내부 분기를 판단합니다. 키가 없거나 호출이 실패하면
# 기존 LangGraph 전이로 자동 fallback합니다.
TYPESAFE_JEV_ENABLED=false
# https://console.typesafe.ai/keys 에서 발급합니다. 실제 키는 커밋하지 마세요.
TYPESAFE_API_KEY=<your-typesafe-api-key>
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=2.0
# 이 값 이상일 때만 Jev 판단을 반영합니다. 범위: 0.0~1.0
TYPESAFE_JEV_MIN_CONFIDENCE=0.8

# ----------------------------------------------------------------------------
# 6. NeMo Guardrails
# ----------------------------------------------------------------------------
# 입력·LLM 출력·Tool Hub 결과에 결정적 NeMo regex rail을 적용합니다.
# false로 두면 기존 app/core/safety.py 검사만 사용합니다.
NEMO_GUARDRAILS_ENABLED=true
# guardrails/config.yml 기준 경로입니다. 절대 경로도 지정할 수 있습니다.
NEMO_GUARDRAILS_CONFIG_PATH=guardrails

# ----------------------------------------------------------------------------
# 7. Tool Hub·RAG
# ----------------------------------------------------------------------------
# true이면 완료 단계에서 LangGraph가 Recipe·Nutrition·Shopping·RAG Tool을 실행합니다.
TOOL_HUB_ENABLED=true
# 비워 두면 프로젝트 내부 data/ CSV를 사용합니다.
# TOOL_HUB_CATALOG_PATH=
# 저장소에 포함된 사전 생성 ChromaDB 경로입니다. 비우면 Chroma 검색을 사용하지 않습니다.
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=recipe_guides
CHROMA_RECIPE_COLLECTION_NAME=recipe_catalog
# true면 API 기동 후 백그라운드에서 CSV 전체를 다시 임베딩합니다. 기본 인덱스만 사용할 때는 반드시 false로 둡니다.
CHROMA_AUTO_INDEX_ON_STARTUP=false

# -----------------------------------------------------------------------------
# 8. 선택 레시피 PDF
# -----------------------------------------------------------------------------
# 선택한 세트 상세 PDF를 저장할 로컬 경로입니다.
PDF_STORAGE_DIRECTORY=output/pdf
# 배포 환경에서 외부 도메인을 반환할 때만 지정합니다. 비우면 /pdfs/{filename}을 반환합니다.
# PDF_PUBLIC_BASE_URL=https://api.example.com
